# Azure service principal credentials generated by infrastructure/bootstrap-*.sh.
# Kept locally (and reused across re-deploys / read by infrastructure/teardown-*.sh)
# but must never be committed, since they contain a client secret. One file
# per target so tearing down one cluster never deletes the other's SP.
infrastructure/azure-credentials-*.json
.vscode
.envrc

# Documentation site build artefacts and local virtualenv (apps/docs).
apps/docs/site/
apps/docs/.venv/
__pycache__/
