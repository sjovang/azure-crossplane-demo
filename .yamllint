---
# Extends yamllint's default ruleset; only overrides what conflicts with
# this repo's existing, consistent conventions.
extends: default

rules:
  document-start:
    present: true
  # The Backstage scaffold's YAML keeps its upstream formatting so version
  # bumps stay easy to diff; only cosmetic rules are relaxed there.
  line-length:
    ignore: |
      apps/backstage/
  comments:
    ignore: |
      apps/backstage/
  comments-indentation:
    ignore: |
      apps/backstage/
