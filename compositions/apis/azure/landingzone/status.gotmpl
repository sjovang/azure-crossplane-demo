{{- $xr := .observed.composite.resource -}}
{{- $catalog := fromJson `__CATALOG__` -}}
{{- $groupStatus := dict -}}
{{- $groupsReady := true -}}
{{- $policiesReady := true -}}
{{- $subscriptionsReady := true -}}
{{- $rootId := "" -}}
{{- $edges := list -}}
{{- $emittedUsages := dict -}}
{{- range $group := $xr.spec.managementGroups -}}
  {{- $prefix := "rootGroups" -}}
  {{- if $group.parentRef -}}{{- $prefix = "managementGroups" -}}{{- end -}}
  {{- $name := printf "%s-%s" $xr.spec.name $group.name -}}
  {{- $key := printf "%s-%s" $prefix $name -}}
  {{- $resource := getComposedResource $ $key | default dict -}}
  {{- $id := (($resource.status | default dict).atProvider | default dict).id | default "" -}}
  {{- $ready := false -}}
  {{- range ($resource.status | default dict).conditions -}}
    {{- if and (eq .type "Ready") (eq .status "True") -}}{{- $ready = true -}}{{- end -}}
  {{- end -}}
  {{- if not (and $id $ready) -}}{{- $groupsReady = false -}}{{- end -}}
  {{- if $id -}}
    {{- $_ := set $groupStatus $group.name (dict "id" $id "name" $name "displayName" $group.displayName) -}}
    {{- if not $group.parentRef -}}{{- $rootId = $id -}}{{- end -}}
  {{- end -}}
  {{- if $group.parentRef -}}
    {{- $parentPrefix := "managementGroups" -}}
    {{- range $parent := $xr.spec.managementGroups -}}
      {{- if and (eq $parent.name $group.parentRef.name) (not $parent.parentRef) -}}{{- $parentPrefix = "rootGroups" -}}{{- end -}}
    {{- end -}}
    {{- $edges = append $edges (dict "of" (printf "%s-%s-%s" $parentPrefix $xr.spec.name $group.parentRef.name) "by" $key) -}}
  {{- end -}}
  {{- range $assignment := $catalog.assignments -}}
    {{- $applies := false -}}
    {{- range $archetype := $group.archetypes -}}
      {{- if has $archetype $assignment.archetypes -}}{{- $applies = true -}}{{- end -}}
    {{- end -}}
    {{- if $applies -}}
      {{- $assignmentName := printf "%s-%s-%s" $xr.spec.name $group.name (trimPrefix "assignment" $assignment.node) -}}
      {{- $assignmentKey := printf "%s-%s" $assignment.node $assignmentName -}}
      {{- $policy := getComposedResource $ $assignmentKey | default dict -}}
      {{- $ready := false -}}
      {{- range ($policy.status | default dict).conditions -}}
        {{- if and (eq .type "Ready") (eq .status "True") -}}{{- $ready = true -}}{{- end -}}
      {{- end -}}
      {{- if not $ready -}}{{- $policiesReady = false -}}{{- end -}}
      {{- $edges = append $edges (dict "of" $key "by" $assignmentKey) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $subscription := $xr.spec.subscriptions -}}
  {{- $key := printf "subscriptions-%s-%s" $xr.spec.name $subscription.name -}}
  {{- $resource := getComposedResource $ $key | default dict -}}
  {{- $associationName := (($resource.status | default dict).managedResourceName | default "") -}}
  {{- $ready := false -}}
  {{- range ($resource.status | default dict).conditions -}}
    {{- if and (eq .type "Ready") (eq .status "True") -}}{{- $ready = true -}}{{- end -}}
  {{- end -}}
  {{- if not (and $ready $associationName) -}}{{- $subscriptionsReady = false -}}{{- end -}}
  {{- range $group := $xr.spec.managementGroups -}}
    {{- if eq $group.name $subscription.managementGroupRef.name -}}
      {{- $prefix := "managementGroups" -}}
      {{- if not $group.parentRef -}}{{- $prefix = "rootGroups" -}}{{- end -}}
      {{- if $associationName -}}
        {{- $edges = append $edges (dict
          "of" (printf "%s-%s-%s" $prefix $xr.spec.name $group.name)
          "byResource" (dict
            "apiVersion" "management.azure.m.upbound.io/v1beta1"
            "kind" "ManagementGroupSubscriptionAssociation"
            "metadata" (dict "name" $associationName))) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $edge := $edges -}}
  {{- $of := getComposedResource $ $edge.of | default dict -}}
  {{- $by := dict -}}
  {{- $byName := $edge.by | default "" -}}
  {{- if $edge.by -}}
    {{- $by = getComposedResource $ $edge.by | default dict -}}
  {{- else -}}
    {{- $by = $edge.byResource | default dict -}}
    {{- $byName = $by.metadata.name | default "" -}}
  {{- end -}}
  {{- if and $of.metadata $by.metadata }}
  {{- $usageName := printf "usage-%s-%s" $edge.of $byName -}}
  {{- $_ := set $emittedUsages $usageName true }}
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  annotations:
    {{ setResourceNameAnnotation $usageName }}
spec:
  replayDeletion: true
  of:
    apiVersion: {{ $of.apiVersion }}
    kind: {{ $of.kind }}
    resourceRef:
      name: {{ $of.metadata.name }}
  by:
    apiVersion: {{ $by.apiVersion }}
    kind: {{ $by.kind }}
    resourceRef:
      name: {{ $by.metadata.name }}
  {{- end -}}
{{- end }}
{{- range $name, $observed := .observed.resources -}}
  {{- $usage := $observed.resource -}}
  {{- if and (eq $usage.kind "Usage") (eq ($usage.spec.by.kind | default "") "ManagementGroupSubscriptionAssociation") (not (hasKey $emittedUsages $name)) }}
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  name: {{ $usage.metadata.name }}
  namespace: {{ $xr.metadata.namespace }}
  annotations:
    {{ setResourceNameAnnotation $name }}
spec: {{ $usage.spec | toJson }}
  {{- end -}}
{{- end }}
---
apiVersion: azure.platform.example.org/v1alpha1
kind: XLandingZoneArchitecture
metadata:
  {{- if not (and $groupsReady $policiesReady $subscriptionsReady) }}
  annotations:
    gotemplating.fn.crossplane.io/ready: "False"
  {{- else }}
  annotations: {}
  {{- end }}
status:
  id: {{ $rootId | quote }}
  managementGroups: {{ $groupStatus | toJson }}
  libraryVersion: platform/alz/2026.10.0
  policyProfile: audit-deny-v1
---
apiVersion: meta.gotemplating.fn.crossplane.io/v1alpha1
kind: ClaimConditions
conditions:
  - type: ManagementGroupsReady
    status: {{ ternary "True" "False" $groupsReady | quote }}
    reason: {{ ternary "Available" "WaitingForManagementGroups" $groupsReady }}
    message: Management groups must have observed Azure IDs and Ready=True.
  - type: PoliciesReady
    status: {{ ternary "True" "False" $policiesReady | quote }}
    reason: {{ ternary "Available" "WaitingForPoliciesOrInputs" $policiesReady }}
    message: Every expected audit/deny assignment must be Ready; check policyDefaults and composed resource conditions.
  - type: SubscriptionsReady
    status: {{ ternary "True" "False" $subscriptionsReady | quote }}
    reason: {{ ternary "Available" "WaitingForSubscriptionAttachments" $subscriptionsReady }}
    message: Every declared subscription attachment must be Ready and expose its association resource name.
