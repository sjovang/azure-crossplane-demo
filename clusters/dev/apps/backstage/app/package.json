{
  "name": "backstage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "concurrently \"npm run start --workspace=packages/backend\" \"npm run start --workspace=packages/app\"",
    "build:backend": "npm run build --workspace=packages/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "overrides": {
    "@backstage/core-compat-api": "0.2.7",
    "@backstage/core-components": "0.14.9",
    "@backstage/core-plugin-api": "1.9.3",
    "@backstage/frontend-plugin-api": "0.6.7",
    "@backstage/integration-react": "1.1.29",
    "@backstage/plugin-permission-react": "0.4.24",
    "@backstage/plugin-search-react": "1.7.13",
    "@backstage/theme": "0.5.6",
    "@backstage/version-bridge": "1.0.8",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.63.4",
    "@swc/core-linux-arm64-gnu": "1.16.2"
  }
}
